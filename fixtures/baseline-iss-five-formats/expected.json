 "checks": [
  {
   "id": "omm-formats-agree",
   "description": "For the same object and snapshot, CSV, JSON, XML and KVN yield identical canonical values for every OMM keyword present in all of them."
  },
  {
   "id": "tle-values-match-omm-within-tle-precision",
   "description": "The TLE rendering equals the OMM values except: eccentricity truncated to 7 digits, BSTAR and second derivative rounded (half up) to a 5-digit mantissa, epoch at 1e-8 day resolution."
  },
  {
   "id": "tle-checksums-valid",
   "description": "Every TLE line 1 and line 2 is 69 characters and ends with the modulo-10 checksum (digits count their value, '-' counts 1, everything else 0)."
  },
  {
   "id": "two-digit-year-pivot",
   "description": "TLE epoch years 57-99 map to 1957-1999 and 00-56 to 2000-2056; the resulting ISO epoch equals the OMM EPOCH string."
  },
  {
   "id": "csv-json-omit-constant-metadata",
   "description": "CelesTrak CSV/JSON carry no CENTER_NAME, REF_FRAME, TIME_SYSTEM or MEAN_ELEMENT_THEORY; parsers must default them (EARTH, TEME, UTC, SGP4) rather than fail."
  },
  {
   "id": "xml-ndm-wrapper-omm-2.0",
   "description": "CelesTrak XML has an <ndm> root containing one <omm> per record with id=CCSDS_OMM_VERS and version=2.0; CREATION_DATE and ORIGINATOR elements are present but empty."
  },
  {
   "id": "kvn-blank-mandatory-values",
   "description": "CelesTrak KVN writes CREATION_DATE and ORIGINATOR with blank values and blank OBJECT_ID for analyst objects; MEAN_ELEMENT_THEORY is 'SGP/SGP4'."
  },
  {
   "id": "leading-dot-decimals",
   "description": "CSV, KVN and XML values may start with '.' or '-.' (no leading zero) and use 'E' exponents; JSON carries numbers."
  }
 ],
 "tests": [
  "same-object-all-formats",
  "2-digit-epoch-year",
  "bstar-implicit-decimal"
 ],
 "coverage": {
  "provides": [
   "a current 5-digit object in every rendering",
