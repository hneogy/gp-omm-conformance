 "records": [],
 "checks": [
  {
   "id": "nine-digit-ids-parse",
   "description": "NORAD_CAT_ID values >= 100000000 parse and round-trip as integers in CSV, JSON, XML and KVN."
  },
  {
   "id": "catalog-number-is-integer",
   "description": "NORAD_CAT_ID parses as an integer in every OMM format, including values of six and nine digits, and a ten-digit value is rejected (CCSDS allows up to nine digits); leading zeros and an explicit '+' are legal in KVN."
  },
  {
   "id": "omm-formats-agree",
   "description": "For the same object and snapshot, CSV, JSON, XML and KVN yield identical canonical values for every OMM keyword present in all of them."
  },
  {
   "id": "tle-format-omits-ids-above-99999",
   "description": "A TLE/3LE/2LE request returns only objects with catalog numbers below 100000; if none qualify the response is HTTP 404 'No GP data found'."
  },
  {
   "id": "supgp-extra-keys-tolerated",
   "description": "SupGP CSV/JSON add non-OMM keys (RMS, DATA_SOURCE); parsers must ignore unknown keys rather than fail."
  },
  {
   "id": "classification-c",
   "description": "CLASSIFICATION_TYPE may be 'C' (CelesTrak supplemental) rather than 'U'."
  }
 ],
 "tests": [
  "9-digit-catalog-number",
  "tle-unavailable-above-99999"
 ],
