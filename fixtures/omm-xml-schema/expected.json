 "checks": [
  {
   "id": "xml-ndm-wrapper-omm-2.0",
   "description": "CelesTrak XML has an <ndm> root containing one <omm> per record with id=CCSDS_OMM_VERS and version=2.0; CREATION_DATE and ORIGINATOR elements are present but empty."
  },
  {
   "id": "omm-version-3-accepted",
   "description": "CCSDS_OMM_VERS 3.0 messages (with CLASSIFICATION and MESSAGE_ID in the header) are accepted alongside 2.0."
  }
 ],
 "tests": [
  "xml-schema"
 ],
 "coverage": {
  "provides": [
   "8 XML files validated against ndmxml-2.0.0 and ndmxml-4.0.0"
  ],
  "gaps": [
   "no CelesTrak XML with units attributes, comments or covariance exists; those constructs are covered only by the CCSDS examples and derived variants"
  ]
 },
 "ambiguities": [
  {
   "id": "omm-version-2-vs-3",
   "text": "CelesTrak declares OMM version 2.0 (Silver Book 2009) although the current standard is 3.0 (Blue Book 2023). The 2.0 XML schema set is still downloadable from SANA by direct URL; against the current 4.0.0/3.0 set the documents fail on the fixed version attribute."
  },
  {
   "id": "empty-mandatory-header",
   "text": "CCSDS Table 4-1 makes CREATION_DATE and ORIGINATOR mandatory; CelesTrak emits them empty in XML and blank in KVN. The 2.0 schema's epochType pattern accepts an empty string, so schema validation may pass; the KVN rule 7.5.1 is still violated."
  }
 ],
